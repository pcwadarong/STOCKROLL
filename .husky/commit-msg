#!/bin/sh

commit_msg=$(cat "$1")

case "$commit_msg" in
  "feat:"*|"fix:"*|"refactor:"*|"style:"*|"docs:"*|"chore:"*|"remove:"*|"test:"*|"perf:"*|"ci:"*|"Merge"*)
    exit 0
    ;;
  *)
    echo "❌ 커밋 메시지가 허용된 유형으로 시작하지 않습니다."
    echo "허용된 유형: feat:, fix:, refactor:, style:, docs:, chore:, remove:, test:, perf:, ci:, Merge"
    echo "예시: feat: 3:4 프레임 내보내기"
    exit 1
    ;;
esac
